rules_version = '2';

service cloud.firestore {
  // TRAINING/MARKETING PERMISSION FIX: these rules must also be published in Firebase Console.
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return /databases/$(database)/documents/users/$(request.auth.uid); }
    function admin(){ return signedIn() && ((request.auth.token.admin == true) || (exists(me()) && get(me()).data.role in ["admin", "Admin", "ADMIN"]) || (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin" && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true)); }
    function worker(){ return signedIn() && exists(me()) && get(me()).data.role == "worker"; }
    function member(){ return signedIn() && exists(me()) && get(me()).data.role == "member"; }
    function validWithdrawalDebit(uid, oldUser, newUser) {
      let wid = newUser.lastWithdrawalRequestId;
      let withdrawalPath = /databases/$(database)/documents/withdrawals/$(wid);
      return signedIn()
        && request.auth.uid == uid
        && oldUser.role in ["worker", "member"]
        && oldUser.wallet is number
        && newUser.wallet is number
        && newUser.wallet >= 0
        && newUser.wallet < oldUser.wallet
        && newUser.diff(oldUser).affectedKeys().hasOnly(["wallet", "updatedAt", "lastWithdrawalRequestId"])
        && wid is string
        && existsAfter(withdrawalPath)
        && getAfter(withdrawalPath).data.workerId == uid
        && getAfter(withdrawalPath).data.requestId == wid
        && getAfter(withdrawalPath).data.status == "pending"
        && getAfter(withdrawalPath).data.amount == oldUser.wallet - newUser.wallet;
    }

    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ["worker", "member"]
        && (request.resource.data.role != "member" || request.resource.data.ownerId is string);
      allow update: if admin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role","wallet","status","lastWithdrawalRequestId"])
        )
        || validWithdrawalDebit(uid, resource.data, request.resource.data);
      allow delete: if admin();
    }

    match /gigs/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /offers/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /projects/{id} {
      allow read: if admin() || (worker() && resource.data.workerId == request.auth.uid);
      allow create,update,delete: if admin() || (worker() && request.resource.data.workerId == request.auth.uid);
    }
    match /categories/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /trainings/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /marketingMaterials/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /services/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /applications/{id} {
      allow read: if admin() || (worker() && resource.data.workerId == request.auth.uid);
      allow create: if worker() && request.resource.data.workerId == request.auth.uid;
      allow update,delete: if admin();
    }
    match /tasks/{id} {
      allow read: if admin() || (worker() && resource.data.workerId == request.auth.uid) || (member() && resource.data.memberId == request.auth.uid);
      allow create,update: if admin() || (worker() && request.resource.data.workerId == request.auth.uid) || (member() && resource.data.memberId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","completedBy","completedAt"]));
      allow delete: if admin();
    }
    match /leads/{id} {
      allow read: if admin() || (worker() && resource.data.workerId == request.auth.uid) || (member() && resource.data.memberId == request.auth.uid);
      allow create: if
        (worker() && request.resource.data.workerId == request.auth.uid)
        || (member() && request.resource.data.memberId == request.auth.uid && request.resource.data.workerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId)
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && request.resource.data.workerId is string
          && request.resource.data.workerId.size() >= 10
          && request.resource.data.workerId.size() <= 128
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() >= 2
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 10
          && request.resource.data.phone.size() <= 15
          && request.resource.data.pincode is string
          && request.resource.data.pincode.size() >= 5
          && request.resource.data.pincode.size() <= 10
          && request.resource.data.gigId is string
          && request.resource.data.gigTitle is string
          && request.resource.data.status == "interview_pending"
          && request.resource.data.walletCredited == false
          && request.resource.data.source == "customer_share"
          && request.resource.data.consent == true
          && request.resource.data.taskAmount is number
          && request.resource.data.taskAmount >= 0
        );
      allow update,delete: if admin();
    }
    match /withdrawals/{id} {
      function userBefore() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid));
      }
      function userAfter() {
        return getAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      }

      allow read: if admin()
        || ((worker() || member()) && resource.data.workerId == request.auth.uid);

      allow create: if signedIn()
        && (worker() || member())
        && request.resource.data.keys().hasOnly([
          "workerId", "workerEmail", "amount", "paymentMethod", "transferType",
          "upiId", "accountHolder", "accountNumber", "bankName", "ifscCode", "status",
          "createdAt", "requestId"
        ])
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.paymentMethod in ["UPI", "BANK ACCOUNT"]
        && request.resource.data.transferType in ["IMPS", "NEFT"]
        && request.resource.data.upiId is string
        && request.resource.data.accountHolder is string
        && request.resource.data.accountNumber is string
        && request.resource.data.bankName is string
        && request.resource.data.ifscCode is string
        && (
          (request.resource.data.paymentMethod == "UPI"
            && request.resource.data.upiId.matches('^[A-Za-z0-9._-]{2,256}@[A-Za-z]{2,64}$'))
          ||
          (request.resource.data.paymentMethod == "BANK ACCOUNT"
            && request.resource.data.accountHolder.size() >= 2
            && request.resource.data.accountHolder.size() <= 100
            && request.resource.data.accountNumber.matches('^[0-9]{6,24}$')
            && request.resource.data.bankName.size() >= 2
            && request.resource.data.bankName.size() <= 100
            && request.resource.data.ifscCode.matches('^[A-Z]{4}0[A-Z0-9]{6}$'))
        )
        && request.resource.data.status == "pending"
        && request.resource.data.requestId == id
        && request.resource.data.createdAt == request.time
        && userBefore().data.wallet is number
        && userBefore().data.wallet >= request.resource.data.amount
        && userAfter().data.wallet == userBefore().data.wallet - request.resource.data.amount
        && userAfter().data.lastWithdrawalRequestId == id;

      allow update: if admin()
        && request.resource.data.workerId == resource.data.workerId
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.transferType == resource.data.transferType
        && request.resource.data.upiId == resource.data.upiId
        && request.resource.data.accountHolder == resource.data.accountHolder
        && request.resource.data.accountNumber == resource.data.accountNumber
        && request.resource.data.bankName == resource.data.bankName
        && request.resource.data.ifscCode == resource.data.ifscCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "proofUrl", "proofPath", "proofFileName", "proofUploadedAt",
          "proofUploadedBy", "paymentReference", "paymentReferenceRecordedAt",
          "approvedAt", "approvedBy", "paidAt", "paidBy", "rejectedAt",
          "rejectedBy", "updatedAt", "processedBy", "adminNote"
        ])
        && (
          (resource.data.status == "pending"
            && request.resource.data.status in ["processing", "rejected"])
          || (resource.data.status == "processing"
            && request.resource.data.status in ["processing", "paid", "rejected"])
        )
        && (request.resource.data.status != "paid" || request.resource.data.proofUrl is string);

      allow delete: if admin() && resource.data.status == "pending";
    }

    match /teamMembers/{id} {
      allow read: if admin()
        || (worker() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create: if worker()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.memberRole is string
        && request.resource.data.status in ["added", "invited"];
      allow update: if admin()
        || (worker()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        || (member()
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUid","status","activatedAt"]));
      allow delete: if admin()
        || (worker() && resource.data.ownerId == request.auth.uid);
    }

    match /activity/{id} {
      allow read: if admin() || (worker() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /{document=**} { allow read,write: if false; }
  }
}))
          ||
          (request.resource.data.paymentMethod == "BANK ACCOUNT"
            && request.resource.data.accountNumber is string
            && request.resource.data.accountNumber.matches('^[0-9]{6,24}
        && request.resource.data.status == "pending"
        && request.resource.data.requestId == id
        && request.resource.data.createdAt == request.time
        && userBefore().data.wallet is number
        && userBefore().data.wallet >= request.resource.data.amount
        && userAfter().data.wallet == userBefore().data.wallet - request.resource.data.amount
        && userAfter().data.lastWithdrawalRequestId == id;
      allow update: if admin()
        && request.resource.data.workerId == resource.data.workerId
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.accountNumber == resource.data.accountNumber
        && request.resource.data.bankName == resource.data.bankName
        && request.resource.data.ifscCode == resource.data.ifscCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "proofUrl", "proofPath", "proofFileName", "proofUploadedAt",
          "proofUploadedBy", "paymentReference", "paymentReferenceRecordedAt",
          "approvedAt", "approvedBy", "paidAt", "paidBy", "rejectedAt",
          "rejectedBy", "updatedAt", "processedBy", "adminNote"
        ])
        && (
          (resource.data.status == "pending"
            && request.resource.data.status in ["processing", "rejected"])
          || (resource.data.status == "processing"
            && request.resource.data.status in ["processing", "paid", "rejected"])
        )
        && (request.resource.data.status != "paid" || request.resource.data.proofUrl is string);
      allow delete: if admin() && resource.data.status == "pending";
    }

    match /teamMembers/{id} {
      allow read: if admin()
        || (worker() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create: if worker()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.memberRole is string
        && request.resource.data.status in ["added", "invited"];
      allow update: if admin()
        || (worker()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        || (member()
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUid","status","activatedAt"]));
      allow delete: if admin()
        || (worker() && resource.data.ownerId == request.auth.uid);
    }

    match /activity/{id} {
      allow read: if admin() || (worker() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /{document=**} { allow read,write: if false; }
  }
})
            && request.resource.data.bankName is string
            && request.resource.data.bankName.size() >= 2
            && request.resource.data.bankName.size() <= 100
            && request.resource.data.ifscCode is string
            && request.resource.data.ifscCode.matches('^[A-Z]{4}0[A-Z0-9]{6}
        && request.resource.data.status == "pending"
        && request.resource.data.requestId == id
        && request.resource.data.createdAt == request.time
        && userBefore().data.wallet is number
        && userBefore().data.wallet >= request.resource.data.amount
        && userAfter().data.wallet == userBefore().data.wallet - request.resource.data.amount
        && userAfter().data.lastWithdrawalRequestId == id;
      allow update: if admin()
        && request.resource.data.workerId == resource.data.workerId
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.accountNumber == resource.data.accountNumber
        && request.resource.data.bankName == resource.data.bankName
        && request.resource.data.ifscCode == resource.data.ifscCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "proofUrl", "proofPath", "proofFileName", "proofUploadedAt",
          "proofUploadedBy", "paymentReference", "paymentReferenceRecordedAt",
          "approvedAt", "approvedBy", "paidAt", "paidBy", "rejectedAt",
          "rejectedBy", "updatedAt", "processedBy", "adminNote"
        ])
        && (
          (resource.data.status == "pending"
            && request.resource.data.status in ["processing", "rejected"])
          || (resource.data.status == "processing"
            && request.resource.data.status in ["processing", "paid", "rejected"])
        )
        && (request.resource.data.status != "paid" || request.resource.data.proofUrl is string);
      allow delete: if admin() && resource.data.status == "pending";
    }

    match /teamMembers/{id} {
      allow read: if admin()
        || (worker() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create: if worker()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.memberRole is string
        && request.resource.data.status in ["added", "invited"];
      allow update: if admin()
        || (worker()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        || (member()
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUid","status","activatedAt"]));
      allow delete: if admin()
        || (worker() && resource.data.ownerId == request.auth.uid);
    }

    match /activity/{id} {
      allow read: if admin() || (worker() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /{document=**} { allow read,write: if false; }
  }
