rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return /databases/$(database)/documents/users/$(request.auth.uid); }
    function admin(){ return signedIn() && exists(me()) && get(me()).data.role == "admin"; }
    function worker(){ return signedIn() && exists(me()) && get(me()).data.role == "worker"; }
    function member(){ return signedIn() && exists(me()) && get(me()).data.role == "member"; }
    function validWithdrawalDebit(uid, oldUser, newUser) {
      let wid = newUser.lastWithdrawalRequestId;
      let withdrawalPath = /databases/$(database)/documents/withdrawals/$(wid);
      return signedIn()
        && request.auth.uid == uid
        && oldUser.role in ["worker", "member"]
        && oldUser.wallet is number
        && newUser.wallet is number
        && newUser.wallet >= 0
        && newUser.wallet < oldUser.wallet
        && wid is string
        && existsAfter(withdrawalPath)
        && getAfter(withdrawalPath).data.workerId == uid
        && getAfter(withdrawalPath).data.requestId == wid
        && getAfter(withdrawalPath).data.status == "pending"
        && getAfter(withdrawalPath).data.amount == oldUser.wallet - newUser.wallet;
    }

    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role in ["worker", "member"]
        && (request.resource.data.role != "member" || request.resource.data.ownerId is string);
      allow update: if admin()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role","wallet","status","lastWithdrawalRequestId"])
        )
        || validWithdrawalDebit(uid, resource.data, request.resource.data);
      allow delete: if admin();
    }

    match /gigs/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /projects/{id} {
      allow read: if admin() || (worker() && resource.data.workerId == request.auth.uid);
      allow create,update,delete: if admin() || (worker() && request.resource.data.workerId == request.auth.uid);
    }
    match /categories/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /trainings/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /services/{id} { allow read: if signedIn(); allow create,update,delete: if admin(); }
    match /applications/{id} {
      allow read: if admin() || (worker() && resource.data.workerId == request.auth.uid);
      allow create: if worker() && request.resource.data.workerId == request.auth.uid;
      allow update,delete: if admin();
    }
    match /tasks/{id} {
      allow read: if admin() || (worker() && resource.data.workerId == request.auth.uid) || (member() && resource.data.memberId == request.auth.uid);
      allow create,update: if admin() || (worker() && request.resource.data.workerId == request.auth.uid) || (member() && resource.data.memberId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","completedBy","completedAt"]));
      allow delete: if admin();
    }
    match /leads/{id} {
      allow read: if admin() || (worker() && resource.data.workerId == request.auth.uid) || (member() && resource.data.memberId == request.auth.uid);
      allow create: if
        (worker() && request.resource.data.workerId == request.auth.uid)
        || (member() && request.resource.data.memberId == request.auth.uid && request.resource.data.workerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId)
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && request.resource.data.workerId is string
          && exists(/databases/$(database)/documents/users/$(request.resource.data.workerId))
          && get(/databases/$(database)/documents/users/$(request.resource.data.workerId)).data.role == "worker"
          && request.resource.data.customerName is string
          && request.resource.data.customerName.size() >= 2
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 10
          && request.resource.data.phone.size() <= 15
          && request.resource.data.pincode is string
          && request.resource.data.pincode.size() >= 5
          && request.resource.data.pincode.size() <= 10
          && request.resource.data.gigId is string
          && request.resource.data.gigTitle is string
          && request.resource.data.status == "interview_pending"
          && request.resource.data.walletCredited == false
          && request.resource.data.source == "customer_share"
          && request.resource.data.consent == true
          && request.resource.data.taskAmount is number
          && request.resource.data.taskAmount >= 0
        );
      allow update,delete: if admin();
    }
    match /withdrawals/{id} {
      allow read: if admin() || ((worker() || member()) && resource.data.workerId == request.auth.uid);
      allow create: if (worker() || member())
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == "pending"
        && request.resource.data.requestId is string
        && request.resource.data.requestId == request.resource.id
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastWithdrawalRequestId == request.resource.data.requestId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.wallet is number;
      allow update,delete: if admin();
    }
    match /teamMembers/{id} {
      allow read: if admin()
        || (worker() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create: if worker()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.memberRole is string
        && request.resource.data.status in ["added", "invited"];
      allow update: if admin()
        || (worker()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        || (member()
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUid","status","activatedAt"]));
      allow delete: if admin()
        || (worker() && resource.data.ownerId == request.auth.uid);
    }

    match /activity/{id} {
      allow read: if admin() || (worker() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /{document=**} { allow read,write: if false; }
  }
}